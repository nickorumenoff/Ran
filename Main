let rot=0,busy=false;
const ans=()=>S.get("ans",{});
function remaining(){const a=ans();return WHEEL.filter(w=>!(w.id in a))}
function pt(r,a){return [r*Math.sin(a),-r*Math.cos(a)]}
function drawWheel(){
  const g=$("#wg"),R=remaining(),n=R.length;g.style.transition="none";rot=0;g.style.transform="rotate(0deg)";g.textContent="";
  const NS="http://www.w3.org/2000/svg";
  if(!n){const t=document.createElementNS(NS,"circle");t.setAttribute("r",150);t.setAttribute("fill","var(--rose2)");g.append(t);
    const x=document.createElementNS(NS,"text");x.setAttribute("text-anchor","middle");x.setAttribute("y",-50);x.setAttribute("font-size","26");x.setAttribute("fill","#fff");x.textContent="¡Listo!";g.append(x);$("#spin").disabled=true;return}
  $("#spin").disabled=false;const st=2*Math.PI/n;
  R.forEach((w,i)=>{
    const p=document.createElementNS(NS,"path"),a0=i*st,a1=(i+1)*st;
    if(n==1){p.setAttribute("d","M0 -150A150 150 0 1 1 -0.01 -150Z")}
    else{const [x0,y0]=pt(150,a0),[x1,y1]=pt(150,a1);p.setAttribute("d",`M0 0L${x0} ${y0}A150 150 0 ${st>Math.PI?1:0} 1 ${x1} ${y1}Z`)}
    p.setAttribute("fill",COLORS[i%4]);p.setAttribute("stroke","#fff");p.setAttribute("stroke-width","2");g.append(p);
    const t=document.createElementNS(NS,"text"),mid=(i+.5)*st*180/Math.PI;
    t.setAttribute("transform",`rotate(${mid}) translate(0 -88)`);t.setAttribute("text-anchor","middle");t.setAttribute("fill","#fff");t.setAttribute("font-size","20");t.setAttribute("font-weight","600");t.textContent=w.l;g.append(t)});
}
function drawRes(){
  const a=ans(),r=$("#res");r.textContent="";
  WHEEL.forEach(w=>{if(w.id in a){const ok=a[w.id]===w.ok;
    r.append(el("div","",(ok?"✅ ":"💭 ")+w.q+" → "+w.o[a[w.id]]+(ok?"":"  (la buena: "+w.o[w.ok]+")")))}});
  if(!remaining().length){const n=WHEEL.filter(w=>ans()[w.id]===w.ok).length;r.append(el("div","","Aciertos: "+n+" de "+WHEEL.length+" 🤍"))}
}
$("#spin").onclick=()=>{
  if(busy)return;const R=remaining(),n=R.length;if(!n)return;busy=true;$("#spin").disabled=true;
  const i=Math.floor(Math.random()*n),step=360/n,center=(i+.5)*step,jit=(Math.random()-.5)*step*.6;
  const g=$("#wg");g.style.transition="transform 4.2s cubic-bezier(.12,.7,.1,1)";
  rot=360*(Math.floor(rot/360)+6)-center+jit;g.style.transform=`rotate(${rot}deg)`;
  setTimeout(()=>{busy=false;askWheel(R[i])},4400);
};
function askWheel(w){
  const m=$("#md");m.textContent="";m.append(el("h2","",w.l),el("p","",w.q));
  let locked=false;
  w.o.forEach((o,i)=>{const b=el("button","opt",o);
    b.onclick=()=>{if(locked)return;locked=true;const a=ans();a[w.id]=i;S.set("ans",a);
      b.classList.add(i===w.ok?"ok":"bad");
      if(i!==w.ok)m.querySelectorAll(".opt")[w.ok].classList.add("ok");
      const msg=el("p","sub",i===w.ok?"¡Esa era la buena! 🤍":"Casi… la buena estaba marcada en verde.");
      const c=el("button","btn","Continuar");c.style.marginTop="16px";
      c.onclick=()=>{closeM();drawWheel();drawRes()};m.append(msg,c)};
    m.append(b)});
  $("#ovM").classList.add("on");
}

