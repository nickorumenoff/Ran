  c.onclick=closeM;
  a.onclick=()=>{const d=S.get("cup",[]);if(!d.includes(i))d.push(i);S.set("cup",d);drawCoupons();closeM();
    window.location.href="https://wa.me/"+PHONE+"?text="+encodeURIComponent("Hola! canjeé este cupón: "+COUPONS[i][1])};
  r.append(a,c);m.append(r);$("#ovM").classList.add("on");
}
