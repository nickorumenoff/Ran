/* contraseña */
async function unlock(){const v=$("#gp").value;let ok=false;
  try{const b=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(v));ok=[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,"0")).join("")==="30b2c1a6296516302517d0793905a8eb411f2967bb2b388d343e2b8285c66785"}catch(e){}
  if(ok){try{localStorage.setItem("rania_ok","1")}catch(e){}document.documentElement.classList.remove("locked");window.scrollTo(0,0)}
  else{$("#ge").textContent="Contraseña incorrecta, intenta de nuevo 🤍";$("#gp").value=""}}
$("#gb").onclick=unlock;$("#gp").addEventListener("keydown",e=>{if(e.key==="Enter")unlock()});
</script>
