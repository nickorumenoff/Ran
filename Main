function drawCoupons(){
  const done=S.get("cup",[]),g=$("#cg");g.textContent="";
  COUPONS.forEach(([e,n],i)=>{
    const b=el("button","cup"+(done.includes(i)?" done":""));
    b.append(el("span","em",e),el("b","",n));
    if(!done.includes(i))b.onclick=()=>askCoupon(i);
    g.append(b)});
}
function askCoupon(i){
  const m=$("#md");m.textContent="";
  m.append(el("div","",""),el("h2","","¿Canjear este cupón?"),el("p","",COUPONS[i][1]),el("p","sub","Si aceptas, queda canjeado y no se renueva hasta que Nicko diga."));
